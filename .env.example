# GEMINI_API_KEY: Required for Gemini AI API calls.
# AI Studio automatically injects this at runtime from user secrets.
GEMINI_API_KEY="MY_GEMINI_API_KEY"

# APP_URL: The URL where this applet is hosted.
# AI Studio automatically injects this at runtime with the Cloud Run service URL.
APP_URL="MY_APP_URL"

# ADMIN_EMAIL: Primary administrator Google account email authorized for /admin access.
ADMIN_EMAIL="mostafaelfoly1000@gmail.com"

# OWNER_NOTIFICATION_EMAIL: Supermarket owner email address for automatic new order alerts.
OWNER_NOTIFICATION_EMAIL="mostafaelfoly1000@gmail.com"

# EMAIL NOTIFICATIONS (Configure EITHER Resend OR SMTP server credentials in Secrets)
# Option A: Resend API
RESEND_API_KEY=""
EMAIL_FROM="Al Andalus Supermarket <orders@yourdomain.com>"

# Option B: Gmail App Password (automatic smtp.gmail.com) or Standard SMTP
GMAIL_USER=""
GMAIL_APP_PASSWORD=""
SMTP_HOST=""
SMTP_PORT="465"
SMTP_USER=""
SMTP_PASS=""

# WHATSAPP BUSINESS CLOUD API (Official Meta Cloud API for automatic owner WhatsApp alerts)
WHATSAPP_CLOUD_TOKEN=""
WHATSAPP_PHONE_NUMBER_ID=""
WHATSAPP_ADMIN_TO="201110688934"
WHATSAPP_TEMPLATE_NAME=""
